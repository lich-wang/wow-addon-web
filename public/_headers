/assets/*
  Cache-Control: public, max-age=31536000, immutable

/addons/*.zip
  Cache-Control: public, max-age=0, must-revalidate

# OpenMap 分块：文件名就是内容的 sha256，URL 不可变（跨版本稳定），可以长期缓存
/addons/openmap/chunks/*
  Cache-Control: public, max-age=31536000, immutable

# 分块清单要能及时指向新版本
/addons/openmap/parts.json
  Cache-Control: public, max-age=0, must-revalidate

/downloads/client-version.json
  Cache-Control: public, max-age=0, must-revalidate
