{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions for wow addon web",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-addon-commands"
  ],
  "remote": {
    "urls": [
      "https://wow.lich.tech",
      "https://wow.lich.tech/*",
      "https://*.wow-addon-web.pages.dev",
      "https://*.wow-addon-web.pages.dev/*"
    ]
  }
}
