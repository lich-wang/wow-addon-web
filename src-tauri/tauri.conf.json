{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "WoW-Addon-Manager",
  "version": "1.0.8",
  "identifier": "tech.lich.wowaddon",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "魔兽世界插件管理器",
        "url": "https://wow.lich.tech",
        "width": 1280,
        "height": 850,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
